<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="using:Textalonia.Controls"
        x:Class="Textalonia.Demo.MainWindow"
        Title="Textalonia — document studio"
        Width="1100" Height="850" MinWidth="700" MinHeight="500"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,24">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5">
        <TextBlock Text="TEXTALONIA" FontSize="11" FontWeight="Bold" LetterSpacing="2"
                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
        <TextBlock Text="Document studio" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="A native editor. Your content, your application." FontSize="13" Opacity="0.7" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <CheckBox x:Name="ReadOnlyToggle" Content="Read only" />
        <ToggleSwitch x:Name="ThemeToggle" OffContent="Light" OnContent="Dark" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,22,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewButton" Content="New document" />
        <Button x:Name="OpenButton" Content="Open..." />
        <Button x:Name="SaveButton" Content="Save as..." />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="TEXTALONIA   /   HTML   /   RTF   /   DOCX   /   TXT"
                 VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
    </Grid>
    <text:TextaloniaEditor x:Name="Editor" Grid.Row="2"
                         AutomationProperties.Name="Document content"
                         DocumentPadding="38,30" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="2,12,2,0">
      <TextBlock x:Name="Status" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
      <Button x:Name="ConversionReportButton" Grid.Column="1" Content="Conversion report" IsEnabled="False" Margin="12,0" />
      <TextBlock x:Name="Counts" Grid.Column="2" FontSize="12" Opacity="0.6" />
    </Grid>
  </Grid>
</Window>
