<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Textalonia</PackageId>
    <Authors>Textalonia contributors</Authors>
    <Copyright>Copyright (c) 2026 Textalonia contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kstanki2/Textalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kstanki2/Textalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <ApiCompatEnableRuleAttributesMustMatch>true</ApiCompatEnableRuleAttributesMustMatch>
    <Description>Textalonia provides independent native rich text editing and document serialization for Avalonia 12. Preview release.</Description>
    <PackageTags>avalonia;richtext;editor;document</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[$(AvaloniaVersion),13.0.0)" />
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/baselines/curated/*" Pack="true" PackagePath="docs/baselines/curated/" />
    <Content Include="Themes/Generic.axaml" Pack="true" PackagePath="sources/Themes/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE;../../THIRD-PARTY-NOTICES.md;../../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
