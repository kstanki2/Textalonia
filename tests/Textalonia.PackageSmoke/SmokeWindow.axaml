<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="using:Textalonia.Controls"
        x:Class="Textalonia.PackageSmoke.SmokeWindow"
        Width="640" Height="360">
  <Grid RowDefinitions="*,*">
    <text:TextaloniaEditor x:Name="Editor" Text="Package consumer" />
    <text:MarkdownViewer x:Name="Markdown" Grid.Row="1" Markdown="# Package Markdown" />
  </Grid>
</Window>
